---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Temas" description="Em breve: meu primeiro tema WordPress" pathname="/temas">
  <section style="text-align:center; padding:3rem 1rem;">
    <h1 style="font-size:2.2rem; margin-bottom:1rem;">
      Temas WordPress
    </h1>
    <p style="font-size:1.1rem; max-width:700px; margin:0 auto;">
      Aqui, você encontra temas que desenvolvi para WordPress.
    </p>
  </section>

  <section style="max-width:1000px; margin:0 auto; padding:2rem 1rem;">
    <div style="display:grid; gap:1.5rem; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));">
      
      <article style="background:#fff; border-radius:.5rem; box-shadow:0 1px 4px rgba(0,0,0,.1); padding:1.5rem;">
        <h2 style="margin-top:0; font-size:1.25rem;">
          <a href="/temas/belo-bigode">
            Belo Bigode
          </a>
        </h2>
        <p>
          Tema desenvolvido para o blog "A Bela e o Bigode", focado em melhorar performance, SEO e experiência do usuário.
          Serve também como um projeto de aprendizado em desenvolvimento de temas WordPress.
        </p>
      </article>

    </div>
  </section>
</Layout>
